{
  "name": "btg-lms-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build": "pnpm api:types && vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:settings-integration": "playwright test --config playwright.settings-integration.config.ts",
    "seed:e2e:learner": "go run ./tools/learner-e2e-seed",
    "test:e2e:learner-integration": "playwright test --config playwright.learner-integration.config.ts",
    "seed:e2e:auth": "go run ./tools/auth-e2e-seed seed",
    "test:e2e:auth-integration": "playwright test --config playwright.auth-integration.config.ts",
    "seed:e2e:community": "go run ./tools/community-e2e-seed seed",
    "test:e2e:community-integration": "playwright test --config playwright.community-integration.config.ts",
    "inspect:e2e:certificate": "go run ./tools/certificate-e2e-seed",
    "test:e2e:certificate-integration": "playwright test --config playwright.certificates-integration.config.ts",
    "seed:e2e:admin": "go run ./tools/admin-e2e-seed seed",
    "test:e2e:admin-integration": "playwright test --config playwright.admin-integration.config.ts",
    "seed:e2e:authoring": "go run ./tools/authoring-e2e-seed seed",
    "test:e2e:authoring-integration": "playwright test --config playwright.authoring-integration.config.ts",
    "seed:e2e:translation": "go run ./tools/translation-e2e-seed seed",
    "test:e2e:translation-integration": "playwright test --config playwright.translation-integration.config.ts",
    "test:openbadges-interop": "node tools/openbadges-interop.mjs tools/testdata/openbadges-interop-active.json",
    "api:types": "openapi-typescript api/openapi.yaml -o frontend/src/api/generated.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/vue-3": "3.31.3",
    "reka-ui": "2.10.4",
    "vue": "3.5.42",
    "vue-i18n": "11.4.10",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@digitalbazaar/data-integrity": "2.0.0",
    "@digitalbazaar/data-integrity-context": "2.0.0",
    "@digitalbazaar/eddsa-rdfc-2022-cryptosuite": "1.3.0",
    "@playwright/test": "1.63.0",
    "@testing-library/vue": "8.1.0",
    "@vitejs/plugin-vue": "6.0.8",
    "jsdom": "30.0.1",
    "jsonld-signatures": "11.5.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  }
}
