BTG_LMS_DATABASE_URL=postgres://btg:btg_dev_password@127.0.0.1:5432/btg_lms?sslmode=disable
BTG_LMS_HTTP_ADDR=127.0.0.1:8080
BTG_LMS_METRICS_ADDR=127.0.0.1:9090
BTG_LMS_MODE=development
BTG_LMS_PUBLIC_ORIGIN=http://localhost:5173
BTG_LMS_ASSET_STORAGE_PATH=/tmp/btg-lms-assets
BTG_LMS_CERTIFICATE_ISSUER_ID=https://academy.example.com
BTG_LMS_CERTIFICATE_ISSUER_NAME=Academy
# Temporary configurable default: 100 MiB. The stream itself is always bounded.
BTG_LMS_ASSET_MAX_BYTES=104857600
# Defaults to true. Self-hosted deployments may set false to allow a Review
# submitter to decide their own cycle; authoring.review.decide authorization still applies.
BTG_LMS_REQUIRE_INDEPENDENT_REVIEW=true

# Keep stable for the installation: changing it changes Open Badges recipient pseudonyms.
BTG_LMS_OPEN_BADGES_SUBJECT_SECRET=replace-with-at-least-32-secret-bytes
